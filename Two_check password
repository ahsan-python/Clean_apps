import json
import os

PASSWORD_FILE = 'password.json'

def file_check():
    """Checks if the password file already exists on the system."""
    return os.path.exists(PASSWORD_FILE)
def password_validator():
    """Handles new password creation and strength validation."""
    print("\n--- FIRST TIME SETUP ---")
    while True:
password = input("Create your new password: ")         
        confirm_password = input("Confirm your new password: ")
        if password != confirm_password:
            print("\n[ERROR] Passwords do not match! Please try again.")
            continue
            
        length_check = False
        has_digits = False
        has_special = False
        # Length check
        if len(password) >= 8:
            length_check = True
        # Character checks
        for char in password:
            if char.isdigit():
                has_digits = True
            elif char in "#$%&@!?*":
                has_special = True
                
        # Final validation evaluation
        if length_check and has_digits and has_special:
            print("[SUCCESS] Password meets all security criteria!")
            return password
        else:
            print("\nWeak password. Fix the following:")
            if not length_check:
                print("- Must be at least 8 characters long.")
            if not has_digits:
                print("- Must include at least one digit.")
            if not has_special:
                print("- Must include a special symbol from (#$%&@!?*).")
def saving_new_password(password):
    """Saves the validated password securely to the JSON file."""
    with open(PASSWORD_FILE, 'w') as f:
        json.dump(password, f, indent=4)     
    print("[INFO] Password configuration saved successfully!\n")

def signing_page():
    """Reads the saved password and blocks access until correct password is entered."""
    with open(PASSWORD_FILE, 'r') as f:
        saved_password = json.load(f)
        
    print("\n--- APP LOGIN GATE ---")
    while True:
        entered_password = input("Enter your password to access the app: ")
        if entered_password == saved_password:
            print("\n[ACCESS GRANTED] Welcome inside the app! 🚀")
            return True
        else:
            print("\n[ACCESS DENIED] Incorrect password! Try again.")

# --- Main Program Execution Flow ---
if __name__ == '__main__':
    print("=== SECURE APP BOOTING UP ===")
    
    # Check if a password already exists
    if file_check():
        # Case 1: Password exists -> Go straight to the login gate
        signing_page()
    else:
        # Case 2: No password -> Force setup, save it, and then let them log in
        valid_password = password_validator()
        saving_new_password(valid_password)
        signing_page()
